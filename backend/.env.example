# Copy this file to .env and fill in your own local values.
PORT=5000
DB_HOST=localhost
# Keep your existing PostgreSQL port if your server uses a non-default port.
DB_PORT=5432
DB_NAME=findit_portal
DB_USER=findit_app
DB_PASSWORD=REPLACE_WITH_YOUR_DATABASE_PASSWORD
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_BYTES
JWT_EXPIRES_IN=2h
# Comma-separated exact frontend origins; local development ports are allowed by default.
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
DB_POOL_MAX=10
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
